{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "historia_id",
    "invest_ok",
    "preguntas",
    "escenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "historia_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{0,31}$"
    },
    "invest_ok": {
      "type": "boolean"
    },
    "preguntas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "pattern": "\\S"
      }
    },
    "escenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "titulo",
          "tipo",
          "dado",
          "cuando",
          "entonces"
        ],
        "additionalProperties": false,
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tipo": {
            "enum": [
              "exito",
              "error",
              "borde"
            ]
          },
          "dado": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "cuando": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "entonces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "invest_ok": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "preguntas": {
        "maxItems": 0
      },
      "escenarios": {
        "minItems": 2,
        "maxItems": 4,
        "allOf": [
          {
            "contains": {
              "properties": {
                "tipo": {
                  "const": "exito"
                }
              }
            }
          },
          {
            "contains": {
              "properties": {
                "tipo": {
                  "enum": [
                    "error",
                    "borde"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "else": {
    "properties": {
      "escenarios": {
        "maxItems": 0
      },
      "preguntas": {
        "minItems": 1,
        "maxItems": 3
      }
    }
  }
}
